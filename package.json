{
  "name": "tepobaby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env.local --watch server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "NODE_ENV=production node server/index.js",
    "check:neetcode": "node scripts/check-neetcode.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.14",
    "@huggingface/transformers": "3.8.1",
    "codemirror": "^6.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "jspdf": "^4.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unpdf": "1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "^9.2.4",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  }
