{
  "name": "tepobaby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env.local --watch server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "google-auth-library": "^10.9.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "^9.2.4",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  }
}
