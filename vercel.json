{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,shared/**,src/data/**,node_modules/onnxruntime-node/bin/napi-v3/linux/x64/**}",
      "excludeFiles": "{server/data/**,node_modules/onnxruntime-web/**,node_modules/onnxruntime-node/bin/napi-v3/{darwin,win32,linux/arm64}/**,node_modules/@huggingface/transformers/dist/*.{wasm,map}}"
    }
  },
  "crons": [{ "path": "/api/cron/jobs", "schedule": "0 11 * * *" }]
}
