{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/**,shared/**,src/data/**}",
      "excludeFiles": "{server/data/**,node_modules/onnxruntime-node/**,node_modules/onnxruntime-web/**,node_modules/@huggingface/**,node_modules/sharp/**}"
    }
  },
  "crons": [{ "path": "/api/cron/jobs", "schedule": "0 11 * * *" }]
}
