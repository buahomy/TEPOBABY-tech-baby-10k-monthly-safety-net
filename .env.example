# Copy to .env.local (git-ignored) and fill in. See README "Google sign-in".

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized JavaScript origins: http://localhost:5173
#   Authorized redirect URIs:      http://localhost:5173/api/auth/google/callback
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string used to sign session cookies: openssl rand -base64 48
SESSION_SECRET=

# Public origin of the app (used to build the OAuth redirect URI). No trailing slash.
APP_ORIGIN=http://localhost:5173

# Optional: Google Jobs via SerpApi (paid, https://serpapi.com). Adds roles indexed from LinkedIn,
# Indeed, Glassdoor and company sites. Leave empty to skip.
SERPAPI_KEY=

# Set to "off" to stop checking job sources (e.g. while working offline).
JOBS_FEED=

# Daily job update time in Eastern Time (HH:MM). Default 07:00.
JOBS_DAILY_TIME=

# Ginny (the "+" button)
# Voyage AI embeddings for ATS match analysis (free tier, no card): https://dash.voyageai.com
# Without it, ATS analysis still runs with BM25 + the local reranker (semantic fit is skipped).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Gemini for "Ask Gemini" (free tier): https://aistudio.google.com/app/apikey
# Gemini 1.5 Flash is retired and 2.5 Flash is closed to new keys; 3.8 Flash (Interactions API) is the default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: models to try when the main one is overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Interview → Behavioral: live AI voice interviewer (OpenAI Realtime API over WebRTC).
# Server-only; the browser gets a short-lived client secret per session.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
